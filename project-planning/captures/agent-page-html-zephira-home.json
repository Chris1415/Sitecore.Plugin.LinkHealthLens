":\\\"d4fd7e5d-bc23-4a97-9ebf-fe190c21bea5\\\",\\\"templateName\\\":\\\"Page\\\",\\\"placeholders\\\":{\\\"headless-header\\\":[{\\\"uid\\\":\\\"c49bae24-0b36-44a7-b183-1e891457553f\\\",\\\"componentName\\\":\\\"PartialDesignDynamicPlaceholder\\\",\\\"dataSource\\\":\\\"\\\",\\\"isContentResolved\\\":true,\\\"params\\\":{\\\"sid\\\":\\\"{C49BAE24-0B36-44A7-B183-1E891457553F}\\\",\\\"ph\\\":\\\"headless-header\\\",\\\"sig\\\":\\\"sxa-header\\\"},\\\"placeholders\\\":{\\\"sxa-header\\\":[{\\\"uid\\\":\\\"1f39fb90-8c25-441e-bf9a-4d84c01272a0\\\",\\\"componentName\\\":\\\"SiteHeader\\\",\\\"dataSource\\\":\\\"\\\",\\\"isContentResolved\\\":true}]}}],\\\"headless-main\\\":[{\\\"uid\\\":\\\"c25fef5c-6018-4d88-ad56-496b5e799d84\\\",\\\"componentName\\\":\\\"CinematicHero\\\",\\\"dataSource\\\":\\\"562b191a-8911-48e0-9022-2a5956d913e2\\\",\\\"isContentResolved\\\":true,\\\"fields\\\":{\\\"heroEyebrow\\\":{\\\"value\\\":\\\"Conscious travel, published honestly\\\"},\\\"heroHeading\\\":{\\\"value\\\":\\\"Fly where the air is worth breathing\\\"},\\\"heroSubheading\\\":{\\\"value\\\":\\\"Every ZEPHIRA route is published with the sky and the air quality you will arrive into — measured, timestamped, and never rounded in our favour. Read the world first. Then book.\\\"},\\\"heroUnlitEyebrow\\\":{\\\"value\\\":\\\"Live sky reading unavailable — every fare and every departure is still bookable\\\"}}},{\\\"uid\\\":\\\"73b21d03-6d17-4203-bde2-2fd1bc751162\\\",\\\"componentName\\\":\\\"Search\\\",\\\"dataSource\\\":\\\"{BA481B3C-7845-40DD-ACAD-17B0E20B548E}\\\",\\\"isContentResolved\\\":true,\\\"fields\\\":{\\\"searchReasonLabel\\\":{\\\"value\\\":\\\"Anywhere · choose by reason\\\"},\\\"searchWhereToLabel\\\":{\\\"value\\\":\\\"Where to?\\\"},\\\"searchDestinationLabel\\\":{\\\"value\\\":\\\"Or choose a destination\\\"},\\\"searchNamePlaceLabel\\\":{\\\"value\\\":\\\"Name a place\\\"}}},{\\\"uid\\\":\\\"a6c825a1-57a0-4725-aa5d-dd7afe5c9b5b\\\",\\\"componentName\\\":\\\"LiveConditionsStrip\\\",\\\"dataSource\\\":\\\"506bd724-b54a-4df6-8b3e-2763806a569b\\\",\\\"isContentResolved\\\":true,\\\"fields\\\":{\\\"destinations\\\":[{\\\"id\\\":\\\"9b31f9d4-8445-4936-a8c6-d48fbc0023fe\\\",\\\"url\\\":\\\"/destinations/Lisbon\\\",\\\"name\\\":\\\"Lisbon\\\",\\\"displayName\\\":\\\"Lisbon\\\",\\\"fields\\\":{\\\"airport\\\":{\\\"id\\\":\\\"b46e490d-9178-4606-9e35-1edd0dfb0cb9\\\",\\\"url\\\":\\\"/Data/Airports/Lisbon?sc_site=Zephira\\\",\\\"name\\\":\\\"Lisbon\\\",\\\"displayName\\\":\\\"Lisbon\\\",\\\"fields\\\":{\\\"airportName\\\":{\\\"value\\\":\\\"Humberto Delgado Airport\\\"},\\\"cityName\\\":{\\\"value\\\":\\\"Lisbon\\\"},\\\"iataCode\\\":{\\\"value\\\":\\\"LIS\\\"},\\\"latitude\\\":{\\\"value\\\":38.7813},\\\"longitude\\\":{\\\"value\\\":-9.1359},\\\"region\\\":{\\\"value\\\":\\\"Europe\\\"}}},\\\"cardImage\\\":{\\\"value\\\":{\\\"src\\\":\\\"https://xmc-developerex211b-hahnsolo3097-cm7744.sitecorecloud.io/-/media/Project/Zephira-Brand/Zephira/zeph-lisbon-card.jpg?h=1529\\u0026iar=0\\u0026w=2048\\u0026ttc=63923840751\\u0026tt=11DC6B67AE7CB9EEAA5AB85450D7CFE3\\\",\\\"alt\\\":\\\"A tiled Lisbon street with tram rails climbing between azulejo facades\\\",\\\"width\\\":\\\"2048\\\",\\\"height\\\":\\\"1529\\\"}},\\\"heroImage\\\":{\\\"value\\\":{\\\"src\\\":\\\"https://xmc-developerex211b-hahnsolo3097-cm7744.sitecorecloud.io/-/media/Project/Zephira-Brand/Zephira/zeph-lisbon-hero.jpg?h=1143\\u0026iar=0\\u0026w=2048\\u0026ttc=63923840751\\u0026tt=56DD5B89A65DC058299626553F1918E2\\\",\\\"alt\\\":\\\"Lisbon rooftops stepping down to the Tagus estuary in clear morning light\\\",\\\"width\\\":\\\"2048\\\",\\\"height\\\":\\\"1143\\\"}},\\\"region\\\":{\\\"id\\\":\\\"36c130cd-eb8d-45f9-a0c8-71e6651c8355\\\",\\\"url\\\":\\\"/Data/Regions/Europe?sc_site=Zephira\\\",\\\"name\\\":\\\"Europe\\\",\\\"displayName\\\":\\\"Europe\\\",\\\"fields\\\":{\\\"label\\\":{\\\"value\\\":\\\"Europe\\\"},\\\"sortOrder\\\":{\\\"value\\\":10}}},\\\"shortIntro\\\":{\\\"value\\\":\\\"Pastel-tiled hills and the Atlantic light, a short hop south of home.\\\"},\\\"storyBody\\\":{\\\"value\\\":\\\"\\u003cp\\u003eLisbon climbs from the Tagus in tiled terraces, its trams still grinding up gradients steep enough to need them. The Atlantic reaches this city before it reaches anywhere else in Europe, and the same westerly that keeps the streets cool keeps the air over them moving.\\u003c/p\\u003e\\u003cp\\u003eTwo hours thirty-five, three departures a week, and the newest destination on the network. Come for the light. Stay because the walk back up the hill is worth it.\\u003c/p\\u003e\\\"},\\\"title\\\":{\\\"value\\\":\\\"Lisbon\\\"},\\\"Page Design\\\":{\\\"id\\\":\\\"e0306441-b119-4786-b0be-76b5042b8e55\\\",\\\"url\\\":\\\"/Presentation/Page-Designs/Page?sc_site=Zephira\\\",\\\"name\\\":\\\"Page\\\",\\\"displayName\\\":\\\"Page\\\",\\\"fields\\\":{\\\"PartialDesigns\\\":[{\\\"id\\\":\\\"c49bae24-0b36-44a7-b183-1e891457553f\\\",\\\"url\\\":\\\"/Presentation/Partial-Designs/Header\\\",\\\"name\\\":\\\"Header\\\",\\\"displayName\\\":\\\"Header\\\",\\\"fields\\\":{\\\"Base Partial Design\\\":null,\\\"Signature\\\":{\\\"value\\\":\\\"header\\\"}}},{\\\"id\\\":\\\"b8724b3a-31ea-43e5-8c22-e1715f2fc64b\\\",\\\"url\\\":\\\"/Presentation/Partial-Designs/Footer\\\",\\\"name\\\":\\\"Footer\\\",\\\"displayName\\\":\\\"Footer\\\",\\\"fields\\\":{\\\"Base Partial Design\\\":null,\\\"Signature\\\":{\\\"value\\\":\\\"footer\\\"}}}]}}}},{\\\"id\\\":\\\"f5a0ae28-daaf-4857-86e5-20666a99312f\\\",\\\"url\\\":\\\"/destinations/Dubai\\\",\\\"name\\\":\\\"Dubai\\\",\\\"displayName\\\":\\\"Dubai\\\",\\\"fields\\\":{\\\"airport\\\":{\\\"id\\\":\\\"683e3eb2-9505-4144-b11d-9141b784ca0f\\\",\\\"url\\\":\\\"/Data/Airports/Dubai?sc_site=Zephira\\\",\\\"name\\\":\\\"Dubai\\\",\\\"displayName\\\":\\\"Dubai\\\",\\\"fields\\\":{\\\"airportName\\\":{\\\"value\\\":\\\"Dubai International\\\"},\\\"cityName\\\":{\\\"value\\\":\\\"Dubai\\\"},\\\"iataCode\\\":{\\\"value\\\":\\\"DXB\\\"},\\\"latitude\\\":{\\\"value\\\":25.3},\\\"longitude\\\":{\\\"value\\\":55.4},\\\"region\\\":{\\\"value\\\":\\\"Middle East\\\"}}},\\\"cardImage\\\":{\\\"value\\\":{\\\"src\\\":\\\"https://xmc-developerex211b-hahnsolo3097-cm7744.sitecorecloud.io/-/media/Project/Zephira-Brand/Zephira/zeph-dubai-card.jpg?h=1529\\u0026iar=0\\u0026w=2048\\u0026ttc=63923840751\\u0026tt=7F733EF4B8C61957515BDB6299799050\\\",\\\"alt\\\":\\\"Dubai towers layered through desert dust above a dune ridge\\\",\\\"width\\\":\\\"2048\\\",\\\"height\\\":\\\"1529\\\"}},\\\"heroImage\\\":{\\\"value\\\":{\\\"src\\\":\\\"https://xmc-developerex211b-hahnsolo3097-cm7744.sitecorecloud.io/-/media/Project/Zephira-Brand/Zephira/zeph-dubai-hero.jpg?h=1143\\u0026iar=0\\u0026w=2048\\u0026ttc=63923840751\\u0026tt=D7141EBDF32D5E3AC7F8C5AA46349AD4\\\",\\\"alt\\\":\\\"The Dubai skyline seen across open desert through airborne dust\\\",\\\"width\\\":\\\"2048\\\",\\\"height\\\":\\\"1143\\\"}},\\\"region\\\":{\\\"id\\\":\\\"005e9c21-7ceb-4548-9895-025f14d2a465\\\",\\\"url\\\":\\\"/Data/Regions/Middle-East?sc_site=Zephira\\\",\\\"name\\\":\\\"Middle East\\\",\\\"displayName\\\":\\\"Middle East\\\",\\\"fields\\\":{\\\"label\\\":{\\\"value\\\":\\\"Middle East\\\"},\\\"sortOrder\\\":{\\\"value\\\":30}}},\\\"shortIntro\\\":{\\\"value\\\":\\\"Desert engineering at full scale, just under seven hours direct.\\\"},\\\"storyBody\\\":{\\\"value\\\":\\\"\\u003cp\\u003eDubai builds upward and outward at once — a coastline that was drawn rather than found, under a skyline that keeps adding storeys. It is the busiest direct route on the network, twice a day every day, and the point where the long eastbound services change aircraft.\\u003c/p\\u003e\\u003cp\\u003eIt also sits in a desert, and desert air behaves like desert air: dust matters more than traffic, and it moves with the wind rather than with the working week. Read the panel the morning you fly, not the month before.\\u003c/p\\u003e\\\"},\\\"title\\\":{\\\"value\\\":\\\"Dubai\\\"},